CONTAINER_NAME=windows-iot-ltsc

# Do not commit .env. Supply an absolute path to a licensed, bootable ISO.
ISO_PATH=/data/iso/en-us_windows_10_iot_enterprise_ltsc_2021_x64_dvd_257ad90f.iso
STORAGE_PATH=/opt/windocker-iot/windows

WEB_PORT=18006
RDP_PORT=13389
SSH_PORT=12222
RAM_SIZE=8G
CPU_CORES=4
DISK_SIZE=128G

WINDOWS_USERNAME=Docker
WINDOWS_PASSWORD=replace-this-password
LANGUAGE=English
REGION=en-US
KEYBOARD=en-US
REMOVE_ISO=N
