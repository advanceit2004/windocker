@echo off
setlocal
set LOG=C:\OEM\customization.log

echo [%date% %time%] Starting customization > "%LOG%"
rem Copy this file to install.bat and add your licensed installers/scripts.
rem The installer runs with administrator rights during the final setup stage.

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0; Set-Service -Name sshd -StartupType Automatic; Start-Service -Name sshd; if (-not (Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue)) { New-NetFirewallRule -Name OpenSSH-Server-In-TCP -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 }" >> "%LOG%" 2>&1

rem Add your licensed installers and scripts here.
rem powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\OEM\scripts\configure.ps1 >> "%LOG%" 2>&1

echo [%date% %time%] Customization complete >> "%LOG%"
exit /b 0
